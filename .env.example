ANTHROPIC_API_KEY=sk-ant-replace-me
KITE_API_KEY=replace-me
KITE_API_SECRET=replace-me

# Turso Cloud Database (optional — leave empty for local SQLite)
# Install: uv pip install libsql-experimental
# Setup:
#   1. turso auth login
#   2. turso db create trading
#   3. turso db create market-data
#   4. turso db show trading --url       → copy to TURSO_TRADING_URL
#   5. turso db show market-data --url   → copy to TURSO_MARKET_URL
#   6. turso db tokens create trading    → copy to TURSO_TRADING_TOKEN
#   7. turso db tokens create market-data → copy to TURSO_MARKET_TOKEN
TURSO_TRADING_URL=
TURSO_TRADING_TOKEN=
TURSO_MARKET_URL=
TURSO_MARKET_TOKEN=

# Telegram Notifications (optional)
# 1. Message @BotFather on Telegram → /newbot → get token
# 2. Message @userinfobot → get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
